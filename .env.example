# OpenAI API Key
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=your-openai-api-key

# Toolbench API Key
# 从 Toolbench 获取
TOOLBENCH_API_KEY=your-toolbench-api-key

# 可选：Cohere API Key（用于 rerank）
# 从 https://cohere.com/ 获取
# COHERE_API_KEY=your-cohere-api-key

# 可选：RapidAPI Key（如果使用 RapidAPI 服务）
# 从 https://rapidapi.com/ 获取
# RAPIDAPI_KEY=your-rapidapi-key
